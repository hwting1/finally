# Optional: LLM provider API key for chat functionality.
# Leave empty to launch with chat disabled unless LLM_MOCK=true.
LLM_API_KEY=

# Default: Google Gemini OpenAI-compatible API base URL.
# Change this to switch providers, or leave empty to use the OpenAI SDK default.
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/

# Default: Google Gemini Flash model used by the OpenAI SDK client.
LLM_MODEL=gemini-3-flash

# Optional: Set to "true" for deterministic mock LLM responses in tests.
LLM_MOCK=false

# Optional: Host port for Docker Compose. Startup scripts default to 8000.
FINALLY_PORT=8000

# SQLite database path inside the container.
DATABASE_PATH=/app/db/finally.db

# Optional: Massive API key for real market data.
# If empty, the backend uses the built-in simulator.
MASSIVE_API_KEY=

# Optional market data tuning.
# MARKET_POLL_INTERVAL_SECONDS=0.5
MARKET_STALE_AFTER_SECONDS=30
MARKET_SIMULATOR_SEED=42

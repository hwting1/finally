# FinAlly local environment template
#
# Copy this file to .env and edit values as needed. Keep real .env files out of git.

# Local Docker port exposed by docker-compose.yml.
FINALLY_PORT=18000

# SQLite database location.
# Docker compose overrides this to /app/db/finally.db inside the container.
DATABASE_PATH=../db/finally.db

# Market data.
# Empty MASSIVE_API_KEY uses the deterministic simulator.
# Set a real key to use Massive REST market data.
MASSIVE_API_KEY=
MARKET_STALE_AFTER_SECONDS=30
MARKET_SIMULATOR_SEED=42

# Optional polling override. Leave blank to use the provider default.
MARKET_POLL_INTERVAL_SECONDS=

# LLM chat.
# Default is live-provider mode. If LLM_API_KEY is empty while LLM_MOCK=false,
# the app still starts, but the AI chat panel is disabled.
# Set LLM_MOCK=true only for deterministic local/E2E testing without an API key.
LLM_MOCK=false
LLM_API_KEY=
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_MODEL=gemini-3-flash-preview
LLM_MAX_ACTIONS=5
LLM_MAX_ORDER_NOTIONAL_PORTFOLIO_FRACTION=0.5
